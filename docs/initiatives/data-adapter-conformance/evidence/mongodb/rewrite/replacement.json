  "movingParts": [
    { "id": "module-factory", "kind": "contract", "reason": "Registers the connector once and compiles source configuration into one route." },
    { "id": "configuration-discovery", "kind": "contract", "reason": "Owns MongoDB-native configuration precedence, discovery facts, and provenance." },
    { "id": "client-manager", "kind": "hot-path", "reason": "Bounds and reuses host-owned MongoClient instances by physical route." },
    { "id": "entity-plan-values", "kind": "hot-path", "reason": "Compiles identity, mapping, polymorphism, and BSON conversion once per repository." },
    { "id": "query-compiler", "kind": "hot-path", "reason": "Lowers Koan filters, sorts, pages, and counts to native driver definitions with exact receipts." },
    { "id": "repository-batch", "kind": "contract", "reason": "Provides one managed-or-explicit CRUD, query, bulk, conditional, and non-atomic batch path." },
    { "id": "schema", "kind": "shared-mechanics", "reason": "Validates External collections and realizes Managed collections and indexes through one bounded gate." },
    { "id": "source-inspection", "kind": "contract", "reason": "Executes bounded named pipelines and projects MongoDB collections and BSON records into neutral Source concepts." },
    { "id": "claims-health", "kind": "contract", "reason": "Publishes native capability truth and probes active routes through the shared client owner." }
