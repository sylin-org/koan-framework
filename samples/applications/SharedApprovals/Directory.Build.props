<Project>
  <!-- This example also runs outside the repository as an ordinary NuGet consumer. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <UseKoanSource>false</UseKoanSource>
    <UsePackagedFoundation Condition="'$(UsePackagedFoundation)' == ''">false</UsePackagedFoundation>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory).local/Framework.props" Condition="Exists('$(MSBuildThisFileDirectory).local/Framework.props')" />
</Project>
