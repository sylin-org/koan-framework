<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Koan.Samples.LocalChecklist.Tests</RootNamespace>
    <LocalChecklistProjectDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..\..\samples\fundamentals\LocalChecklist'))</LocalChecklistProjectDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\samples\fundamentals\LocalChecklist\LocalChecklist.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LocalChecklistProjectDirectory</_Parameter1>
      <_Parameter2>$(LocalChecklistProjectDirectory)</_Parameter2>
    </AssemblyAttribute>
    <!-- The ProjectReference above builds the sample in whatever configuration this suite is built in, so
         the spec must run that same configuration. Naming one here would make the spec pass or fail on
         whether someone had previously built the sample by hand. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LocalChecklistConfiguration</_Parameter1>
      <_Parameter2>$(Configuration)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
