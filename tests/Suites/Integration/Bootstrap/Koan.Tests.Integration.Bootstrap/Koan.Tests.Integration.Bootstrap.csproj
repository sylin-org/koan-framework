<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- ARCH-0091: xUnit v3 runs as a self-executing test assembly (VSTest-compatible mode keeps `dotnet test`). -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Planted manifest for EmbeddedModuleManifestSpec — exercises AppBootstrapper's manifest read/parse/load. -->
    <EmbeddedResource Include="TestData\koan.modules.manifest" LogicalName="koan.modules.manifest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Deterministic bootstrap contracts: no pillar or infrastructure modules belong in this lane. -->
    <ProjectReference Include="..\..\..\..\..\src\Koan.Testing.Hosting\Koan.Testing.Hosting.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\Koan.Core\Koan.Core.csproj" />
    <!-- Built first but neither referenced nor copied beside the test assembly: a default-context AddKoan() scans the
         output's loose Koan.*.dll files, and would load it there. CopyUntouchedApplication puts it in its own folder,
         from which only UntouchedApplicationServiceSpec's isolated load context loads it. -->
    <ProjectReference Include="..\Koan.Tests.Integration.Bootstrap.UntouchedApplication\Koan.Tests.Integration.Bootstrap.UntouchedApplication.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
    <UntouchedApplicationProject Include="..\Koan.Tests.Integration.Bootstrap.UntouchedApplication\Koan.Tests.Integration.Bootstrap.UntouchedApplication.csproj" />
  </ItemGroup>

  <Target Name="CopyUntouchedApplication" AfterTargets="Build">
    <MSBuild Projects="@(UntouchedApplicationProject)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_UntouchedApplicationAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(_UntouchedApplicationAssembly)" DestinationFolder="$(OutDir)untouched-application" SkipUnchangedFiles="true" />
  </Target>
</Project>
