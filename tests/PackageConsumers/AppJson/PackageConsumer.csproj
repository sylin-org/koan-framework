<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Koan.PackageConsumer.AppJson</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <Target Name="RequireKoanTrainVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(KoanTrainVersion)' == ''"
           Text="Set KoanTrainVersion to the certified package-train version." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Sylin.Koan.App" Version="$(KoanTrainVersion)" />
  </ItemGroup>
</Project>
