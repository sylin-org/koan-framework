<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Koan.Data.Vector.Connector.RedisVector</AssemblyName>
    <RootNamespace>Koan.Data.Vector.Connector.RedisVector</RootNamespace>
    <KoanHasPublishedBaseline>false</KoanHasPublishedBaseline>
    <Description>Redis Search vector provider for Koan: exact FLAT search, native metadata filters, and shared Redis lifecycle.</Description>
    <PackageTags>$(CommonPackageTags);data;vector;redis;redis-search;knn</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Koan.Data.Abstractions\Koan.Data.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\..\Koan.Data.Vector.Abstractions\Koan.Data.Vector.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\..\Koan.Data.Vector\Koan.Data.Vector.csproj" />
    <ProjectReference Include="..\..\..\..\Koan.Data.Core\Koan.Data.Core.csproj" />
    <ProjectReference Include="..\..\..\..\Koan.Core\Koan.Core.csproj" />
    <ProjectReference Include="..\..\..\..\Koan.Redis.Abstractions\Koan.Redis.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\..\Koan.Redis\Koan.Redis.csproj" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>
</Project>
