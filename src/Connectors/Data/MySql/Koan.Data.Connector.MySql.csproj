<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <KoanHasPublishedBaseline>false</KoanHasPublishedBaseline>
    <AssemblyName>Koan.Data.Connector.MySql</AssemblyName>
    <RootNamespace>Koan.Data.Connector.MySql</RootNamespace>
    <Description>MySQL provider for Koan relational data with native filtering, atomic writes, and governed source routing.</Description>
    <PackageTags>$(CommonPackageTags);data;mysql;relational</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Koan.Data.Abstractions\Koan.Data.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Koan.Data.Core\Koan.Data.Core.csproj" />
    <ProjectReference Include="..\..\..\Koan.Data.Relational\Koan.Data.Relational.csproj" />
    <ProjectReference Include="..\..\..\Koan.Core\Koan.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>
</Project>
