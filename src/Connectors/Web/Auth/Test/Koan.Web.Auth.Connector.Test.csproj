<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Test identity provider for Koan Web Auth: local login UI, token issuance for demos, and development-only wiring.</Description>
    <PackageTags>$(CommonPackageTags);web;auth;test-provider;identity</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
  </ItemGroup>
  <!-- The login page is served by StaticController from this embedded resource. It is deliberately NOT
       shipped as Content/wwwroot: a plain-SDK package's wwwroot content re-roots against the CONSUMING
       app's content root in the static-web-assets manifest, so every reference demanded a wwwroot folder
       that minimal template apps do not have (startup DirectoryNotFoundException, blind run 2026-08-27). -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\testprovider-login.html" />
  </ItemGroup>
  <ItemGroup>
  <ProjectReference Include="..\..\..\..\Koan.Web.Auth.Abstractions\Koan.Web.Auth.Abstractions.csproj" />
  <ProjectReference Include="..\..\..\..\Koan.Web.Auth\Koan.Web.Auth.csproj" />
  <ProjectReference Include="..\..\..\..\Koan.Core\Koan.Core.csproj" />
  </ItemGroup>
</Project>
