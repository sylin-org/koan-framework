<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Koan.Data.Hygiene</AssemblyName>
    <RootNamespace>Koan.Data.Hygiene</RootNamespace>
    <Description>Declarative field hygiene for Koan Entities - [Trim], [Lowercase] and [Uppercase] normalize annotated string properties on the persisted clone across every write path.</Description>
    <PackageTags>$(CommonPackageTags);hygiene;normalization;trim;data-quality</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Koan.Tests.Data.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Koan.Core\Koan.Core.csproj" />
    <ProjectReference Include="..\Koan.Data.Abstractions\Koan.Data.Abstractions.csproj" />
    <ProjectReference Include="..\Koan.Data.Core\Koan.Data.Core.csproj" />
  </ItemGroup>
</Project>
