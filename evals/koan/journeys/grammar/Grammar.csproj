<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Every construct the koan skill teaches, compiled against the published packages a developer
    actually installs. If the skill names a package that does not exist, restore fails. If it shows
    an API that does not exist, compile fails. This is the check a pattern-matching lint cannot make.

    Deliberately NOT a repository ProjectReference: the skill's audience consumes Koan from NuGet,
    so the oracle must too.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- A developer's own project is not governed by this repository's central versions. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sylin.Koan.App" Version="$(KoanEvalPackageVersion)" />
    <PackageReference Include="Sylin.Koan.Data.Connector.Sqlite" Version="$(KoanEvalPackageVersion)" />
    <PackageReference Include="Sylin.Koan.Data.AI" Version="$(KoanEvalPackageVersion)" />
    <PackageReference Include="Sylin.Koan.AI" Version="$(KoanEvalPackageVersion)" />
    <PackageReference Include="Sylin.Koan.Data.Vector" Version="$(KoanEvalPackageVersion)" />
    <PackageReference Include="Sylin.Koan.Jobs" Version="$(KoanEvalPackageVersion)" />
    <PackageReference Include="Sylin.Koan.Mcp" Version="$(KoanEvalPackageVersion)" />
    <PackageReference Include="Sylin.Koan.Tenancy" Version="$(KoanEvalPackageVersion)" />
  </ItemGroup>

</Project>
